  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 0,
        "method" => "initialize",
        "params" => %{"clientCapabilities" => %{}, "protocolVersion" => 1}
      }
    },
    result: %{skipped: true, tag: :ok}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{kind: :note, text: "An approval request for a never-opened thread is not fenced"},
    result: %{}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "id" => 100,
        "method" => "item/commandExecution/requestApproval",
        "params" => %{
          "command" => "mix test",
          "cwd" => "/tmp/project",
          "itemId" => "item-1",
          "reason" => "The agent wants to run the test suite",
          "startedAtMs" => 1700000000000,
          "threadId" => "phantom",
          "turnId" => "turn-1"
        }
      }
    },
    result: %{
      messages: [
        %{
          "id" => "codex-permission-<1>",
          "jsonrpc" => "2.0",
          "method" => "session/request_permission",
          "params" => %{
            "_meta" => %{
              "ex_mcp" => %{
                "codex" => %{
                  "method" => "item/commandExecution/requestApproval",
                  "params" => %{
                    "command" => "mix test",
                    "cwd" => "/tmp/project",
                    "itemId" => "item-1",
                    "reason" => "The agent wants to run the test suite",
                    "startedAtMs" => 1700000000000,
                    "threadId" => "phantom",
                    "turnId" => "turn-1"
                  }
                }
              },
              "permission" => %{
                "description" => "The agent wants to run the test suite",
                "title" => "Run command?",
                "version" => 1
              }
            },
            "options" => [
              %{"kind" => "allow_once", "name" => "Yes, proceed", "optionId" => "allow_once"},
              %{
                "kind" => "allow_always",
                "name" => "Yes, and don't ask again for this command in this session",
                "optionId" => "allow_for_session"
              },
              %{
                "kind" => "reject_once",
                "name" => "No, continue without running it",
                "optionId" => "decline"
              },
              %{
                "kind" => "reject_once",
                "name" => "No, and tell Codex what to do differently",
                "optionId" => "cancel"
              }
            ],
            "sessionId" => "phantom",
            "toolCall" => %{
              "kind" => "execute",
              "rawInput" => %{
                "command" => "mix test",
                "cwd" => "/tmp/project",
                "itemId" => "item-1",
                "reason" => "The agent wants to run the test suite",
                "startedAtMs" => 1700000000000,
                "threadId" => "phantom",
                "turnId" => "turn-1"
              },
              "status" => "pending",
              "title" => "mix test",
              "toolCallId" => "item-1",
              "toolName" => "execute"
            }
          }
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "codex-permission-<1>",
        "jsonrpc" => "2.0",
        "result" => %{"outcome" => %{"optionId" => "allow_once", "outcome" => "selected"}}
      }
    },
    result: %{tag: :ok, writes: [%{"id" => 100, "result" => %{"decision" => "accept"}}]}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :note,
      text: "Unlike a notification, the request path does not materialize the session"
    },
    result: %{}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"method" => "session/cancel", "params" => %{"sessionId" => "phantom"}}
    },
    result: %{error: "Unknown Codex session: phantom", tag: :error}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 30, "method" => "session/close", "params" => %{"sessionId" => "phantom"}}
    },
    result: %{error: "Unknown Codex session: phantom", tag: :error}
  }
]
