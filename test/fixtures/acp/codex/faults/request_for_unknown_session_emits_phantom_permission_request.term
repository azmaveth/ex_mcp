[
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        workspace_roots: ["/tmp"],
        cwd: "/tmp/project",
        authorize_mcp_server: :__fun__,
        trust_authorized_workspaces: true
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{kind: :post_connect},
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => 1,
          "method" => "initialize",
          "params" => %{"clientInfo" => %{"name" => "ex_mcp", "version" => "1.0.0"}}
        }
      ]
    }
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{kind: :inbound, message: %{"id" => 1, "result" => %{"capabilities" => %{}}}},
    result: %{
