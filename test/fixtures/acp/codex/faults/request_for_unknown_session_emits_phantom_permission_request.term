      writes: [
        %{"method" => "initialized"},
        %{"id" => 2, "method" => "model/list", "params" => %{"includeHidden" => false}}
      ]
    }
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "id" => 2,
        "result" => %{
          "data" => [
