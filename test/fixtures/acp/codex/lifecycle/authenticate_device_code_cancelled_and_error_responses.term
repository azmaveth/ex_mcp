        cwd: "/tmp/project"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{kind: :post_connect},
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => 1,
          "method" => "initialize",
          "params" => %{"clientInfo" => %{"name" => "ex_mcp", "version" => "1.0.0"}}
        }
      ]
    }
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{kind: :inbound, message: %{"id" => 1, "result" => %{"capabilities" => %{}}}},
    result: %{
      skipped: true,
      tag: :skip_and_write,
      writes: [
        %{"method" => "initialized"},
        %{"id" => 2, "method" => "model/list", "params" => %{"includeHidden" => false}}
      ]
    }
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "id" => 2,
        "result" => %{
          "data" => [
            %{
              "defaultReasoningEffort" => "medium",
              "description" => "Fast coding model",
              "displayName" => "Codex Mini",
              "hidden" => false,
              "id" => "codex-mini",
              "model" => "gpt-5-codex",
              "supportedReasoningEfforts" => [
                %{"description" => "Balanced", "reasoningEffort" => "medium"},
                %{"description" => "Deep", "reasoningEffort" => "high"}
              ]
            },
            %{
              "defaultReasoningEffort" => "high",
              "description" => "General purpose model",
              "displayName" => "GPT-5",
              "hidden" => false,
              "id" => "gpt-5",
              "model" => "gpt-5",
              "supportedReasoningEfforts" => [
                %{"description" => "Quick", "reasoningEffort" => "low"},
                %{"description" => "Deep", "reasoningEffort" => "high"}
              ]
            }
          ],
          "nextCursor" => nil
        }
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 0,
        "method" => "initialize",
        "params" => %{
          "clientCapabilities" => %{
            "elicitation" => %{"url" => %{}},
            "fs" => %{"readTextFile" => true, "writeTextFile" => true}
          },
          "protocolVersion" => 1
        }
      }
    },
    result: %{skipped: true, tag: :ok}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 31,
        "method" => "authenticate",
        "params" => %{"methodId" => "chat-gpt-device-code"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => 3,
          "method" => "account/login/start",
          "params" => %{"type" => "chatgptDeviceCode"}
        }
      ]
    }
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "id" => 3,
        "result" => %{
          "loginId" => "login-1",
          "type" => "chatgptDeviceCode",
          "userCode" => "ABCD-EFGH",
          "verificationUrl" => "https://chatgpt.com/device"
        }
      }
    },
    result: %{
      messages: [
        %{
          "id" => "codex-auth-elicitation-<1>",
          "jsonrpc" => "2.0",
          "method" => "elicitation/create",
          "params" => %{
            "elicitationId" => "login-1",
            "message" => "Sign in to ChatGPT and enter this code: ABCD-EFGH",
            "mode" => "url",
            "requestId" => 31,
            "url" => "https://chatgpt.com/device"
          }
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => "codex-auth-elicitation-<1>", "result" => %{"action" => "cancel"}}
    },
    result: %{
      messages: [
        %{
          "error" => %{"code" => -32603, "message" => "Codex authentication was cancelled"},
          "id" => 31,
          "jsonrpc" => "2.0"
        }
      ],
      tag: :messages_and_write,
      writes: [
        %{"id" => 4, "method" => "account/login/cancel", "params" => %{"loginId" => "login-1"}}
      ]
    }
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{kind: :note, text: "the cancelled login is gone: its completion is ignored"},
    result: %{}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "method" => "account/login/completed",
        "params" => %{"loginId" => "login-1", "success" => true}
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :note,
      text: "a client error response to the elicitation cancels the login the same way"
    },
    result: %{}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
