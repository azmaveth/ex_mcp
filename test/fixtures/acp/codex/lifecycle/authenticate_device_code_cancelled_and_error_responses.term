      tag: :messages_and_write,
      writes: [
        %{"id" => 6, "method" => "account/login/cancel", "params" => %{"loginId" => "login-2"}}
      ]
    }
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :note,
      text: "accept with a non-map content is a cancellation too; a non-string loginId is stringified for the elicitation but echoed as-is to the app-server"
    },
    result: %{}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 33,
