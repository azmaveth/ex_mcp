              },
              "projects" => %{
                "/tmp/project" => %{"trust_level" => "trusted"},
                "/tmp/vendor" => %{"trust_level" => "trusted"}
              },
              "sandbox_workspace_write" => %{"writable_roots" => ["/tmp/vendor"]}
            },
            "cwd" => "/tmp/project",
            "modelProvider" => "custom-gateway",
            "sandbox" => "workspace-write"
          }
        }
      ]
