  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :note,
      text: "A gateway login stores a custom model provider; non-map projects/sandbox/model_providers sections from codex_config are replaced rather than merged"
    },
    result: %{}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 5,
        "method" => "authenticate",
        "params" => %{
          "_meta" => %{
            "gateway" => %{
              "baseUrl" => "https://gateway.example.test/v1",
              "headers" => %{"X-Team" => "platform"},
              "providerName" => "Example Gateway"
            }
          },
          "methodId" => "gateway"
        }
      }
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.CodexGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 10,
        "method" => "session/new",
        "params" => %{
          "additionalDirectories" => ["/tmp/vendor"],
          "cwd" => "/tmp/project",
          "mcpServers" => []
        }
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => 3,
          "method" => "thread/start",
          "params" => %{
            "approvalPolicy" => "on-request",
            "config" => %{
              "model_providers" => %{
