[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-init",
        "jsonrpc" => "2.0",
        "method" => "initialize",
        "params" => %{"clientCapabilities" => %{"elicitation" => %{"form" => %{}}}}
      }
    },
    result: %{skipped: true, tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :post_connect},
    result: %{
      tag: :ok,
      writes: [
        %{
          "request" => %{"subtype" => "initialize"},
          "request_id" => "ex_mcp_initialize_<1>",
          "type" => "control_request"
        }
      ]
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "response" => %{
          "request_id" => "ex_mcp_initialize_<1>",
          "response" => %{},
          "subtype" => "success"
        },
        "type" => "control_response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-new",
        "jsonrpc" => "2.0",
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      reply: %{
        "configOptions" => [
          %{
            "category" => "mode",
            "currentValue" => "default",
            "description" => "Session permission mode",
            "id" => "mode",
            "name" => "Mode",
            "options" => [
              %{
                "description" => "Always ask before making changes",
                "name" => "Manual",
                "value" => "default"
              },
              %{
                "description" => "Automatically accept all file edits",
                "name" => "Accept edits",
                "value" => "acceptEdits"
              },
              %{
                "description" => "Create a plan before making changes",
                "name" => "Plan",
                "value" => "plan"
              }
            ],
            "type" => "select"
          },
          %{
            "category" => "model",
            "currentValue" => "default",
            "description" => "AI model to use",
            "id" => "model",
            "name" => "Model",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Sonnet", "value" => "sonnet"},
              %{"name" => "Opus", "value" => "opus"}
            ],
            "type" => "select"
          },
          %{
            "category" => "thought_level",
            "currentValue" => "default",
            "description" => "Available effort levels for this model",
            "id" => "effort",
            "name" => "Effort",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Low", "value" => "low"},
              %{"name" => "Medium", "value" => "medium"},
              %{"name" => "High", "value" => "high"}
            ],
            "type" => "select"
          }
        ],
        "modes" => %{
          "availableModes" => [
            %{
              "description" => "Always ask before making changes",
              "id" => "default",
              "name" => "Manual"
            },
            %{
              "description" => "Automatically accept all file edits",
              "id" => "acceptEdits",
              "name" => "Accept edits"
            },
            %{
              "description" => "Create a plan before making changes",
              "id" => "plan",
              "name" => "Plan"
            }
          ],
          "currentModeId" => "default"
        },
        "sessionId" => "claude_sdk_<1>"
      },
      tag: :reply
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "request" => %{
          "input" => %{
            "questions" => [
              %{
                "header" => "Color",
                "multiSelect" => false,
                "options" => [
                  %{"description" => "Blue option", "label" => "Blue"},
                  %{"description" => "Green option", "label" => "Green"}
                ],
                "question" => "Which color?"
              },
              %{
                "header" => "Size",
                "multiSelect" => false,
                "options" => [
                  %{"description" => "Small option", "label" => "Small"},
                  %{"description" => "Large option", "label" => "Large"}
                ],
                "question" => "Which size?"
              }
            ]
          },
          "subtype" => "can_use_tool",
          "tool_name" => "AskUserQuestion",
          "tool_use_id" => "toolu_ask"
        },
        "request_id" => "req-ask",
        "type" => "control_request"
      }
    },
    result: %{
      messages: [
        %{
          "id" => "acp-<1>",
          "jsonrpc" => "2.0",
          "method" => "elicitation/create",
          "params" => %{
            "message" => "Please answer the following questions.",
            "mode" => "form",
            "requestedSchema" => %{
              "properties" => %{
                "question_0" => %{
                  "description" => "Which color?",
                  "oneOf" => [
                    %{"const" => "Blue", "description" => "Blue option", "title" => "Blue"},
                    %{"const" => "Green", "description" => "Green option", "title" => "Green"}
                  ],
                  "title" => "Color",
                  "type" => "string"
                },
                "question_0_custom" => %{
                  "_meta" => %{
                    "_askUserQuestionCustomAnswer" => %{
                      "isCustomAnswer" => true,
                      "questionId" => "question_0"
                    }
                  },
                  "description" => "Type your own answer, or add a note to the option you chose above (optional).",
                  "title" => "Other",
                  "type" => "string"
                },
                "question_1" => %{
                  "description" => "Which size?",
                  "oneOf" => [
                    %{"const" => "Small", "description" => "Small option", "title" => "Small"},
                    %{"const" => "Large", "description" => "Large option", "title" => "Large"}
                  ],
                  "title" => "Size",
                  "type" => "string"
                },
                "question_1_custom" => %{
                  "_meta" => %{
                    "_askUserQuestionCustomAnswer" => %{
                      "isCustomAnswer" => true,
                      "questionId" => "question_1"
                    }
                  },
                  "description" => "Type your own answer, or add a note to the option you chose above (optional).",
                  "title" => "Other",
                  "type" => "string"
                }
              },
              "type" => "object"
            },
            "sessionId" => "claude_sdk_<1>",
            "toolCallId" => "toolu_ask"
          }
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-<1>",
        "jsonrpc" => "2.0",
        "result" => %{
          "action" => "accept",
          "content" => %{"question_0" => "Blue", "question_1" => "Large"}
        }
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "response" => %{
            "request_id" => "req-ask",
            "response" => %{
              "behavior" => "allow",
              "decisionClassification" => "user_temporary",
              "toolUseID" => "toolu_ask",
              "updatedInput" => %{
                "answers" => %{"Which color?" => "Blue", "Which size?" => "Large"},
                "questions" => [
                  %{
                    "header" => "Color",
                    "multiSelect" => false,
                    "options" => [
                      %{"description" => "Blue option", "label" => "Blue"},
                      %{"description" => "Green option", "label" => "Green"}
                    ],
                    "question" => "Which color?"
                  },
                  %{
                    "header" => "Size",
                    "multiSelect" => false,
                    "options" => [
                      %{"description" => "Small option", "label" => "Small"},
                      %{"description" => "Large option", "label" => "Large"}
                    ],
                    "question" => "Which size?"
                  }
                ]
              }
            },
            "subtype" => "success"
          },
          "type" => "control_response"
        }
      ]
    }
  }
]
