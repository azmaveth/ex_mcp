[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-new",
        "jsonrpc" => "2.0",
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      reply: %{
        "configOptions" => [
          %{
            "category" => "mode",
            "currentValue" => "default",
            "description" => "Session permission mode",
            "id" => "mode",
            "name" => "Mode",
            "options" => [
              %{
                "_meta" => %{"kind" => "standard"},
                "description" => "Always ask before making changes",
                "name" => "Manual",
                "value" => "default"
              },
              %{
                "_meta" => %{"kind" => "standard"},
                "description" => "Automatically accept all file edits",
                "name" => "Accept edits",
                "value" => "acceptEdits"
              },
              %{
                "_meta" => %{"kind" => "plan"},
                "description" => "Create a plan before making changes",
                "name" => "Plan",
                "value" => "plan"
              },
              %{
                "_meta" => %{"kind" => "auto_review"},
                "description" => "Claude handles permission decisions",
                "name" => "Auto",
                "value" => "auto"
              }
            ],
            "type" => "select"
          },
          %{
            "category" => "model",
            "currentValue" => "default",
            "description" => "AI model to use",
            "id" => "model",
            "name" => "Model",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Sonnet", "value" => "sonnet"},
              %{"name" => "Opus", "value" => "opus"}
            ],
            "type" => "select"
          },
          %{
            "category" => "thought_level",
            "currentValue" => "default",
            "description" => "Available effort levels for this model",
            "id" => "effort",
            "name" => "Effort",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Low", "value" => "low"},
              %{"name" => "Medium", "value" => "medium"},
              %{"name" => "High", "value" => "high"}
            ],
            "type" => "select"
          }
        ],
        "modes" => %{
          "availableModes" => [
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Always ask before making changes",
              "id" => "default",
              "name" => "Manual"
            },
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Automatically accept all file edits",
              "id" => "acceptEdits",
              "name" => "Accept edits"
            },
            %{
              "_meta" => %{"kind" => "plan"},
              "description" => "Create a plan before making changes",
              "id" => "plan",
              "name" => "Plan"
            },
            %{
              "_meta" => %{"kind" => "auto_review"},
              "description" => "Claude handles permission decisions",
              "id" => "auto",
              "name" => "Auto"
            }
          ],
          "currentModeId" => "default"
        },
        "sessionId" => "claude_sdk_<1>"
      },
      tag: :reply
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "request" => %{
          "input" => %{
            "file_path" => "<sandbox>/project/lib/app.ex",
            "new_string" => "b",
            "old_string" => "a"
          },
          "subtype" => "can_use_tool",
          "tool_name" => "Edit",
          "tool_use_id" => "toolu_1"
        },
        "request_id" => "req-1",
        "type" => "control_request"
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "claude_sdk_<1>",
            "update" => %{
              "content" => [
                %{
                  "newText" => "b",
                  "oldText" => "a",
                  "path" => "<sandbox>/project/lib/app.ex",
                  "type" => "diff"
                }
              ],
              "kind" => "edit",
              "locations" => [%{"line" => 1, "path" => "<sandbox>/project/lib/app.ex"}],
              "rawInput" => %{
                "file_path" => "<sandbox>/project/lib/app.ex",
                "new_string" => "b",
                "old_string" => "a"
              },
              "sessionUpdate" => "tool_call",
              "status" => "pending",
              "title" => "Edit lib/app.ex",
              "toolCallId" => "toolu_1"
            }
          }
        },
        %{
          "_meta" => %{"permission" => %{"title" => "Edit lib/app.ex", "version" => 1}},
          "id" => "acp-<1>",
          "jsonrpc" => "2.0",
          "method" => "session/request_permission",
          "params" => %{
            "options" => [
              %{"kind" => "allow_once", "name" => "Allow", "optionId" => "allow_once"},
              %{"kind" => "reject_once", "name" => "Reject", "optionId" => "reject_once"}
            ],
            "sessionId" => "claude_sdk_<1>",
            "toolCall" => %{
              "content" => [
                %{
                  "newText" => "b",
                  "oldText" => "a",
                  "path" => "<sandbox>/project/lib/app.ex",
                  "type" => "diff"
                }
              ],
              "kind" => "edit",
              "locations" => [%{"line" => 1, "path" => "<sandbox>/project/lib/app.ex"}],
              "rawInput" => %{
                "file_path" => "<sandbox>/project/lib/app.ex",
                "new_string" => "b",
                "old_string" => "a"
              },
              "title" => "Edit lib/app.ex",
              "toolCallId" => "toolu_1"
            }
          }
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-<1>",
        "jsonrpc" => "2.0",
        "result" => %{"outcome" => %{"optionId" => "allow_once", "outcome" => "selected"}}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "response" => %{
            "request_id" => "req-1",
            "response" => %{
              "behavior" => "allow",
              "decisionClassification" => "user_temporary",
              "toolUseID" => "toolu_1",
              "updatedInput" => %{
                "file_path" => "<sandbox>/project/lib/app.ex",
                "new_string" => "b",
                "old_string" => "a"
              }
            },
            "subtype" => "success"
          },
          "type" => "control_response"
        }
      ]
    }
  }
]
