[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude",
        allow_dangerously_skip_permissions: true
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-new",
        "jsonrpc" => "2.0",
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      reply: %{
        "configOptions" => [
          %{
            "category" => "mode",
            "currentValue" => "default",
            "description" => "Session permission mode",
            "id" => "mode",
            "name" => "Mode",
            "options" => [
              %{
                "_meta" => %{"kind" => "standard"},
                "description" => "Always ask before making changes",
                "name" => "Manual",
                "value" => "default"
              },
              %{
                "_meta" => %{"kind" => "standard"},
                "description" => "Automatically accept all file edits",
                "name" => "Accept edits",
                "value" => "acceptEdits"
              },
              %{
                "_meta" => %{"kind" => "plan"},
                "description" => "Create a plan before making changes",
                "name" => "Plan",
                "value" => "plan"
              },
              %{
                "_meta" => %{"kind" => "auto_review"},
                "description" => "Claude handles permission decisions",
                "name" => "Auto",
                "value" => "auto"
              },
              %{
                "_meta" => %{"kind" => "full_access"},
                "description" => "Accepts all permissions",
                "name" => "Bypass permissions",
                "value" => "bypassPermissions"
              }
            ],
            "type" => "select"
          },
          %{
            "category" => "model",
            "currentValue" => "default",
            "description" => "AI model to use",
            "id" => "model",
            "name" => "Model",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Sonnet", "value" => "sonnet"},
              %{"name" => "Opus", "value" => "opus"}
            ],
            "type" => "select"
          },
          %{
            "category" => "thought_level",
            "currentValue" => "default",
            "description" => "Available effort levels for this model",
            "id" => "effort",
            "name" => "Effort",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Low", "value" => "low"},
              %{"name" => "Medium", "value" => "medium"},
              %{"name" => "High", "value" => "high"}
            ],
            "type" => "select"
          }
        ],
        "modes" => %{
          "availableModes" => [
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Always ask before making changes",
              "id" => "default",
              "name" => "Manual"
            },
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Automatically accept all file edits",
              "id" => "acceptEdits",
              "name" => "Accept edits"
            },
            %{
              "_meta" => %{"kind" => "plan"},
              "description" => "Create a plan before making changes",
              "id" => "plan",
              "name" => "Plan"
            },
            %{
              "_meta" => %{"kind" => "auto_review"},
              "description" => "Claude handles permission decisions",
              "id" => "auto",
              "name" => "Auto"
            },
            %{
              "_meta" => %{"kind" => "full_access"},
              "description" => "Accepts all permissions",
              "id" => "bypassPermissions",
              "name" => "Bypass permissions"
            }
          ],
          "currentModeId" => "default"
        },
        "sessionId" => "claude_sdk_<1>"
      },
      tag: :reply
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-mode",
        "jsonrpc" => "2.0",
        "method" => "session/set_mode",
        "params" => %{"modeId" => "bypassPermissions", "sessionId" => "claude_sdk_<1>"}
      }
    },
    result: %{
      reply: %{
        "modes" => %{
          "availableModes" => [
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Always ask before making changes",
              "id" => "default",
              "name" => "Manual"
            },
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Automatically accept all file edits",
              "id" => "acceptEdits",
              "name" => "Accept edits"
            },
            %{
              "_meta" => %{"kind" => "plan"},
              "description" => "Create a plan before making changes",
              "id" => "plan",
              "name" => "Plan"
            },
            %{
              "_meta" => %{"kind" => "auto_review"},
              "description" => "Claude handles permission decisions",
              "id" => "auto",
              "name" => "Auto"
            },
            %{
              "_meta" => %{"kind" => "full_access"},
              "description" => "Accepts all permissions",
              "id" => "bypassPermissions",
              "name" => "Bypass permissions"
            }
          ],
          "currentModeId" => "bypassPermissions"
        }
      },
      tag: :reply_and_write,
      writes: [
        %{
          "request" => %{"mode" => "bypassPermissions", "subtype" => "set_permission_mode"},
          "request_id" => "ex_mcp_set_permission_mode_<1>",
          "type" => "control_request"
        }
      ]
    }
  }
]
