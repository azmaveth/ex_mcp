[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude",
        allow_dangerously_skip_permissions: true
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-new",
        "jsonrpc" => "2.0",
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      reply: %{
        "configOptions" => [
          %{
            "category" => "mode",
            "currentValue" => "default",
            "description" => "Session permission mode",
            "id" => "mode",
            "name" => "Mode",
            "options" => [
              %{
                "description" => "Always ask before making changes",
                "name" => "Manual",
                "value" => "default"
              },
              %{
                "description" => "Automatically accept all file edits",
                "name" => "Accept edits",
                "value" => "acceptEdits"
              },
              %{
                "description" => "Create a plan before making changes",
                "name" => "Plan",
                "value" => "plan"
              },
              %{
                "description" => "Accepts all permissions",
                "name" => "Bypass permissions",
                "value" => "bypassPermissions"
              }
            ],
            "type" => "select"
          },
          %{
            "category" => "model",
            "currentValue" => "default",
            "description" => "AI model to use",
            "id" => "model",
            "name" => "Model",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Sonnet", "value" => "sonnet"},
              %{"name" => "Opus", "value" => "opus"}
            ],
            "type" => "select"
          },
          %{
            "category" => "thought_level",
            "currentValue" => "default",
            "description" => "Available effort levels for this model",
            "id" => "effort",
            "name" => "Effort",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Low", "value" => "low"},
              %{"name" => "Medium", "value" => "medium"},
              %{"name" => "High", "value" => "high"}
            ],
            "type" => "select"
          }
        ],
        "modes" => %{
          "availableModes" => [
            %{
              "description" => "Always ask before making changes",
              "id" => "default",
              "name" => "Manual"
            },
            %{
              "description" => "Automatically accept all file edits",
              "id" => "acceptEdits",
              "name" => "Accept edits"
            },
            %{
              "description" => "Create a plan before making changes",
              "id" => "plan",
              "name" => "Plan"
            },
            %{
              "description" => "Accepts all permissions",
              "id" => "bypassPermissions",
              "name" => "Bypass permissions"
            }
          ],
          "currentModeId" => "default"
        },
        "sessionId" => "claude_sdk_<1>"
      },
      tag: :reply
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "request" => %{
          "input" => %{"plan" => "1. Read\n2. Edit"},
          "subtype" => "can_use_tool",
          "tool_name" => "ExitPlanMode",
          "tool_use_id" => "toolu_plan"
        },
        "request_id" => "req-plan",
        "type" => "control_request"
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "claude_sdk_<1>",
            "update" => %{
              "kind" => "other",
              "rawInput" => %{"plan" => "1. Read\n2. Edit"},
              "sessionUpdate" => "tool_call",
              "status" => "pending",
              "title" => "ExitPlanMode",
              "toolCallId" => "toolu_plan"
            }
          }
        },
        %{
          "_meta" => %{"permission" => %{"title" => "Ready to code?", "version" => 1}},
          "id" => "acp-<1>",
          "jsonrpc" => "2.0",
          "method" => "session/request_permission",
          "params" => %{
            "options" => [
              %{
                "kind" => "allow_always",
                "name" => "Yes, and bypass permissions",
                "optionId" => "exit-plan-bypass"
              },
              %{
                "kind" => "allow_once",
                "name" => "Yes, manually approve edits",
                "optionId" => "exit-plan-default"
              },
              %{"kind" => "reject_once", "name" => "No, keep planning", "optionId" => "reject"}
            ],
            "sessionId" => "claude_sdk_<1>",
            "toolCall" => %{
              "kind" => "other",
              "rawInput" => %{"plan" => "1. Read\n2. Edit"},
              "title" => "ExitPlanMode",
              "toolCallId" => "toolu_plan"
            }
          }
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-<1>",
        "jsonrpc" => "2.0",
        "result" => %{"outcome" => %{"optionId" => "exit-plan-bypass", "outcome" => "selected"}}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "response" => %{
            "request_id" => "req-plan",
            "response" => %{
              "behavior" => "allow",
              "decisionClassification" => "user_permanent",
              "toolUseID" => "toolu_plan",
              "updatedInput" => %{"plan" => "1. Read\n2. Edit"},
              "updatedPermissions" => [
                %{"destination" => "session", "mode" => "bypassPermissions", "type" => "setMode"}
              ]
            },
            "subtype" => "success"
          },
          "type" => "control_response"
        }
      ]
    }
  }
]
