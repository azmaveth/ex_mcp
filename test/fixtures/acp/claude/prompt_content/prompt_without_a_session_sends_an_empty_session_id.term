[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-prompt",
        "jsonrpc" => "2.0",
        "method" => "session/prompt",
        "params" => %{"prompt" => "no session yet", "sessionId" => nil}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "message" => %{
            "content" => [%{"text" => "no session yet", "type" => "text"}],
            "role" => "user"
          },
          "parent_tool_use_id" => nil,
          "session_id" => "",
          "type" => "user"
        }
      ]
    }
  }
]
