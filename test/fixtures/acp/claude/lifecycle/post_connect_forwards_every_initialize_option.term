[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude",
        append_system_prompt: "Be brief.",
        system_prompt: "You are a test agent.",
        plan_mode_instructions: "Plan first.",
        title: "Golden",
        skills: ["docx"],
        agents: [%{"name" => "reviewer"}],
        prompt_suggestions: ["Refactor this"],
        agent_progress_summaries: true,
        forward_subagent_text: true
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :post_connect},
    result: %{
      tag: :ok,
      writes: [
        %{
          "request" => %{
            "agentProgressSummaries" => true,
            "agents" => [%{"name" => "reviewer"}],
            "appendSystemPrompt" => "Be brief.",
            "forwardSubagentText" => true,
            "planModeInstructions" => "Plan first.",
            "promptSuggestions" => ["Refactor this"],
            "skills" => ["docx"],
            "subtype" => "initialize",
            "systemPrompt" => ["You are a test agent."],
            "title" => "Golden"
          },
          "request_id" => "ex_mcp_initialize_<1>",
          "type" => "control_request"
        }
      ]
    }
  }
]
