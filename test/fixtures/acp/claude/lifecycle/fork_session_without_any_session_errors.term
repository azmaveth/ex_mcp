[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :fork_session, params: %{"cwd" => "<sandbox>/project"}},
    result: %{error: "Invalid Claude sessionId: nil", tag: :error}
  }
]
