[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :note, text: "A store entry with no cwd cannot be mapped to an ACP SessionInfo"},
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: [%{"message" => %{"content" => "no cwd here", "role" => "user"}, "type" => "user"}],
      kind: :write_file,
      path: "<sandbox>/claude/projects/<sandbox-key>-project/00000001-0000-4000-8000-000000000001.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :list_sessions, params: %{}},
    result: %{
      reply: [
        %{
          "_meta" => %{
            "ex_mcp" => %{
              "claude_sdk" => %{"fileSize" => "<bytes>", "firstPrompt" => "no cwd here"}
            }
          },
          "cwd" => "<sandbox>/project",
          "sessionId" => "00000001-0000-4000-8000-000000000001",
          "title" => "no cwd here",
          "updatedAt" => "<now>"
        }
      ],
      tag: :ok
    }
  }
]
