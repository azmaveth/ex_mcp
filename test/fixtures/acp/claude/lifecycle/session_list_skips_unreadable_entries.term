[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :note,
      text: "Sidechain, blank-summary, non-UUID and empty files are all skipped"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: [
        %{
          "cwd" => "<sandbox>/project",
          "isSidechain" => true,
          "message" => %{"content" => "sub", "role" => "user"},
          "type" => "user"
        }
      ],
      kind: :write_file,
      path: "<sandbox>/claude/projects/<sandbox-key>-project/00000001-0000-4000-8000-000000000001.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: [%{"cwd" => "<sandbox>/project", "type" => "system"}],
      kind: :write_file,
      path: "<sandbox>/claude/projects/<sandbox-key>-project/00000002-0000-4000-8000-000000000002.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: [
        %{
          "cwd" => "<sandbox>/project",
          "gitBranch" => "main",
          "message" => %{"content" => "ignored", "role" => "user"},
          "timestamp" => "2026-01-01T00:00:00Z",
          "type" => "user",
          "uuid" => "user-1"
        }
      ],
      kind: :write_file,
      path: "<sandbox>/claude/projects/<sandbox-key>-project/not-a-uuid.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: "",
      kind: :write_file,
      path: "<sandbox>/claude/projects/<sandbox-key>-project/00000003-0000-4000-8000-000000000003.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :list_sessions, params: %{"cwd" => "<sandbox>/project"}},
    result: %{reply: [], tag: :ok}
  }
]
