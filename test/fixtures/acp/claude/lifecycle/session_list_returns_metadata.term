[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: [
        %{
          "cwd" => "<sandbox>/project",
          "gitBranch" => "main",
          "message" => %{"content" => "summarize the repo", "role" => "user"},
          "timestamp" => "2026-01-01T00:00:00Z",
          "type" => "user",
          "uuid" => "user-1"
        },
        %{"tag" => "release", "type" => "tag"},
        %{"customTitle" => "Repo tour"}
      ],
      kind: :write_file,
      path: "<sandbox>/claude/projects/<sandbox-key>-project/00000001-0000-4000-8000-000000000001.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-list",
        "jsonrpc" => "2.0",
        "method" => "session/list",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      reply: %{
        "sessions" => [
          %{
            "_meta" => %{
              "ex_mcp" => %{
                "claude_sdk" => %{
                  "createdAt" => "2026-01-01T00:00:00Z",
                  "customTitle" => "Repo tour",
                  "fileSize" => "<bytes>",
                  "firstPrompt" => "summarize the repo",
                  "gitBranch" => "main",
                  "tag" => "release"
                }
              }
            },
            "cwd" => "<sandbox>/project",
            "sessionId" => "00000001-0000-4000-8000-000000000001",
            "title" => "Repo tour",
            "updatedAt" => "<now>"
          }
        ]
      },
      tag: :reply
    }
  }
]
