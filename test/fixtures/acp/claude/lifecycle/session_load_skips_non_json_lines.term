[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: "{\"type\":\"user\",\"cwd\":\"<sandbox>/project\",\"message\":{\"role\":\"user\",\"content\":\"hi\"}}\nnot json\n",
      kind: :write_file,
      path: "<sandbox>/claude/projects/<sandbox-key>-project/00000001-0000-4000-8000-000000000001.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-load",
        "jsonrpc" => "2.0",
        "method" => "session/load",
        "params" => %{
          "cwd" => "<sandbox>/project",
          "sessionId" => "00000001-0000-4000-8000-000000000001"
        }
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "00000001-0000-4000-8000-000000000001",
            "update" => %{
              "_meta" => %{"ex_mcp" => %{"claude_sdk" => %{"replay" => true}}},
              "content" => %{"text" => "hi", "type" => "text"},
              "sessionUpdate" => "user_message_chunk"
            }
          }
        }
      ],
      reply: %{
        "configOptions" => [
          %{
            "category" => "mode",
            "currentValue" => "default",
            "description" => "Session permission mode",
            "id" => "mode",
            "name" => "Mode",
            "options" => [
              %{
                "description" => "Always ask before making changes",
                "name" => "Manual",
                "value" => "default"
              },
              %{
                "description" => "Automatically accept all file edits",
                "name" => "Accept edits",
                "value" => "acceptEdits"
              },
              %{
                "description" => "Create a plan before making changes",
                "name" => "Plan",
                "value" => "plan"
              }
            ],
            "type" => "select"
          },
          %{
            "category" => "model",
            "currentValue" => "default",
            "description" => "AI model to use",
            "id" => "model",
            "name" => "Model",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Sonnet", "value" => "sonnet"},
              %{"name" => "Opus", "value" => "opus"}
            ],
            "type" => "select"
          },
          %{
            "category" => "thought_level",
            "currentValue" => "default",
            "description" => "Available effort levels for this model",
            "id" => "effort",
            "name" => "Effort",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Low", "value" => "low"},
              %{"name" => "Medium", "value" => "medium"},
              %{"name" => "High", "value" => "high"}
            ],
            "type" => "select"
          }
        ],
        "modes" => %{
          "availableModes" => [
            %{
              "description" => "Always ask before making changes",
              "id" => "default",
              "name" => "Manual"
            },
            %{
              "description" => "Automatically accept all file edits",
              "id" => "acceptEdits",
              "name" => "Accept edits"
            },
            %{
              "description" => "Create a plan before making changes",
              "id" => "plan",
              "name" => "Plan"
            }
          ],
          "currentModeId" => "default"
        },
        "sessionId" => "00000001-0000-4000-8000-000000000001"
      },
      tag: :messages_and_reply
    }
  }
]
