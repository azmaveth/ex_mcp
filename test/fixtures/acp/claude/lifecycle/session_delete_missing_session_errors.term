[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-delete",
        "jsonrpc" => "2.0",
        "method" => "session/delete",
        "params" => %{
          "cwd" => "<sandbox>/project",
          "sessionId" => "00000002-0000-4000-8000-000000000002"
        }
      }
    },
    result: %{
      error: "Claude session 00000002-0000-4000-8000-000000000002 was not found",
      tag: :error
    }
  }
]
