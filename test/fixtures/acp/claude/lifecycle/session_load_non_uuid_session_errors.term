[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-load",
        "jsonrpc" => "2.0",
        "method" => "session/load",
        "params" => %{"cwd" => "<sandbox>/project", "sessionId" => "not-a-uuid"}
      }
    },
    result: %{error: "Invalid Claude sessionId: \"not-a-uuid\"", tag: :error}
  }
]
