[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-list",
        "jsonrpc" => "2.0",
        "method" => "session/list",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{reply: %{"sessions" => []}, tag: :reply}
  }
]
