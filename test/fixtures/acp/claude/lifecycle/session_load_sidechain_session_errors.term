[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: [
        %{
          "cwd" => "<sandbox>/project",
          "isSidechain" => true,
          "message" => %{"content" => "sub-agent", "role" => "user"},
          "type" => "user"
        }
      ],
      kind: :write_file,
      path: "<sandbox>/claude/projects/<sandbox-key>-project/00000001-0000-4000-8000-000000000001.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-load",
        "jsonrpc" => "2.0",
        "method" => "session/load",
        "params" => %{
          "cwd" => "<sandbox>/project",
          "sessionId" => "00000001-0000-4000-8000-000000000001"
        }
      }
    },
    result: %{
      error: "Claude session 00000001-0000-4000-8000-000000000001 is a sidechain",
      tag: :error
    }
  }
]
