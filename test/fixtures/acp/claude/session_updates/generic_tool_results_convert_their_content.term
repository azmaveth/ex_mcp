[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-new",
        "jsonrpc" => "2.0",
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      reply: %{
        "configOptions" => [
          %{
            "category" => "mode",
            "currentValue" => "default",
            "description" => "Session permission mode",
            "id" => "mode",
            "name" => "Mode",
            "options" => [
              %{
                "_meta" => %{"kind" => "standard"},
                "description" => "Always ask before making changes",
                "name" => "Manual",
                "value" => "default"
              },
              %{
                "_meta" => %{"kind" => "standard"},
                "description" => "Automatically accept all file edits",
                "name" => "Accept edits",
                "value" => "acceptEdits"
              },
              %{
                "_meta" => %{"kind" => "plan"},
                "description" => "Create a plan before making changes",
                "name" => "Plan",
                "value" => "plan"
              },
              %{
                "_meta" => %{"kind" => "auto_review"},
                "description" => "Claude handles permission decisions",
                "name" => "Auto",
                "value" => "auto"
              }
            ],
            "type" => "select"
          },
          %{
            "category" => "model",
            "currentValue" => "default",
            "description" => "AI model to use",
            "id" => "model",
            "name" => "Model",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Sonnet", "value" => "sonnet"},
              %{"name" => "Opus", "value" => "opus"}
            ],
            "type" => "select"
          },
          %{
            "category" => "thought_level",
            "currentValue" => "default",
            "description" => "Available effort levels for this model",
            "id" => "effort",
            "name" => "Effort",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Low", "value" => "low"},
              %{"name" => "Medium", "value" => "medium"},
              %{"name" => "High", "value" => "high"}
            ],
            "type" => "select"
          }
        ],
        "modes" => %{
          "availableModes" => [
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Always ask before making changes",
              "id" => "default",
              "name" => "Manual"
            },
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Automatically accept all file edits",
              "id" => "acceptEdits",
              "name" => "Accept edits"
            },
            %{
              "_meta" => %{"kind" => "plan"},
              "description" => "Create a plan before making changes",
              "id" => "plan",
              "name" => "Plan"
            },
            %{
              "_meta" => %{"kind" => "auto_review"},
              "description" => "Claude handles permission decisions",
              "id" => "auto",
              "name" => "Auto"
            }
          ],
          "currentModeId" => "default"
        },
        "sessionId" => "claude_sdk_<1>"
      },
      tag: :reply
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-prompt",
        "jsonrpc" => "2.0",
        "method" => "session/prompt",
        "params" => %{"prompt" => "hi", "sessionId" => "claude_sdk_<1>"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "message" => %{"content" => [%{"text" => "hi", "type" => "text"}], "role" => "user"},
          "parent_tool_use_id" => nil,
          "session_id" => "claude_sdk_<1>",
          "type" => "user"
        }
      ]
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "message" => %{
          "content" => [
            %{
              "id" => "toolu_1",
              "input" => %{"file_path" => "<sandbox>/project/a.ex"},
              "name" => "Read",
              "type" => "tool_use"
            }
          ],
          "id" => "msg_assistant_1",
          "role" => "assistant"
        },
        "session_id" => "00000001-0000-4000-8000-000000000001",
        "type" => "assistant"
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "claude_sdk_<1>",
            "update" => %{
              "kind" => "read",
              "locations" => [%{"line" => 1, "path" => "<sandbox>/project/a.ex"}],
              "rawInput" => %{"file_path" => "<sandbox>/project/a.ex"},
              "sessionUpdate" => "tool_call",
              "status" => "pending",
              "title" => "Read a.ex",
              "toolCallId" => "toolu_1"
            }
          }
        },
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "claude_sdk_<1>",
            "update" => %{
              "kind" => "read",
              "locations" => [%{"line" => 1, "path" => "<sandbox>/project/a.ex"}],
              "rawInput" => %{"file_path" => "<sandbox>/project/a.ex"},
              "sessionUpdate" => "tool_call_update",
              "status" => "in_progress",
              "title" => "Read a.ex",
              "toolCallId" => "toolu_1"
            }
          }
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "message" => %{
          "content" => [
            %{
              "content" => [
                %{"text" => "line one", "type" => "text"},
                %{"text" => "line two"},
                %{"data" => "QUFB", "type" => "image"}
              ],
              "tool_use_id" => "toolu_1",
              "type" => "tool_result"
            }
          ],
          "role" => "user"
        },
        "session_id" => "00000001-0000-4000-8000-000000000001",
        "type" => "user"
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "claude_sdk_<1>",
            "update" => %{
              "_meta" => %{
                "ex_mcp" => %{
                  "claude_sdk" => %{
                    "isError" => false,
                    "toolInput" => %{"file_path" => "<sandbox>/project/a.ex"},
                    "toolName" => "Read"
                  }
                }
              },
              "content" => [
                %{"content" => %{"text" => "line one", "type" => "text"}, "type" => "content"},
                %{"content" => %{"text" => "line two", "type" => "text"}, "type" => "content"},
                %{
                  "content" => %{
                    "text" => "%{\"data\" => \"QUFB\", \"type\" => \"image\"}",
                    "type" => "text"
                  },
                  "type" => "content"
                }
              ],
              "rawOutput" => "line one\nline two\n%{\"data\" => \"QUFB\", \"type\" => \"image\"}",
              "sessionUpdate" => "tool_call_update",
              "status" => "completed",
              "toolCallId" => "toolu_1"
            }
          }
        }
      ],
      tag: :messages
    }
  }
]
