[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"jsonrpc" => "2.0", "method" => "session/cancel", "params" => %{}}
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "request" => %{"subtype" => "interrupt"},
          "request_id" => "ex_mcp_interrupt_<1>",
          "type" => "control_request"
        }
      ]
    }
  }
]
