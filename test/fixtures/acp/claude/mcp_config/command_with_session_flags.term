[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :command,
      opts: [
        cli_path: "<sandbox>/bin/claude",
        resume: "123e4567-e89b-12d3-a456-426614174000",
        resume_session_at: "msg-7",
        fork_session: true,
        session_id: "123e4567-e89b-12d3-a456-426614174001"
      ]
    },
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--permission-prompt-tool", "stdio", "--permission-mode", "default",
         "--include-partial-messages", "--resume", "123e4567-e89b-12d3-a456-426614174000",
         "--resume-session-at", "msg-7", "--fork-session", "--session-id",
         "123e4567-e89b-12d3-a456-426614174001"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  }
]
