[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-auth",
        "jsonrpc" => "2.0",
        "method" => "authenticate",
        "params" => %{}
      }
    },
    result: %{error: "authenticate requires params.methodId", tag: :error}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => "acp-auth-2", "jsonrpc" => "2.0", "method" => "authenticate"}
    },
    result: %{error: "authenticate requires params.methodId", tag: :error}
  }
]
