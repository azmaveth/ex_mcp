[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :command,
      opts: [
        cli_path: "<sandbox>/bin/claude",
        additional_directories: ["/tmp/shared", nil, "/tmp/other"]
      ]
    },
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--permission-prompt-tool", "stdio", "--permission-mode", "default",
         "--include-partial-messages", "--add-dir", "/tmp/shared", "--add-dir", "/tmp/other"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  }
]
