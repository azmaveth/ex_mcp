[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :note, text: "A zero budget is the documented way to disable thinking"},
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :command, opts: [cli_path: "<sandbox>/bin/claude", max_thinking_tokens: 0]},
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--thinking", "disabled", "--permission-prompt-tool", "stdio", "--permission-mode",
         "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :command, opts: [cli_path: "<sandbox>/bin/claude", max_thinking_tokens: 8000]},
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--max-thinking-tokens", "8000", "--permission-prompt-tool", "stdio",
         "--permission-mode", "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  }
]
