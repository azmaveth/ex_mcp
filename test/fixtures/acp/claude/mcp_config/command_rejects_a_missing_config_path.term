[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :command,
      opts: [cli_path: "<sandbox>/bin/claude", mcp_config_path: "<sandbox>/nope.json"]
    },
    result: %{
      error: {:invalid_option, :mcp_config_path,
       "\"<sandbox>/nope.json\" is not an existing file"},
      tag: :error
    }
  }
]
