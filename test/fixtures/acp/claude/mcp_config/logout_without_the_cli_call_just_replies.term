[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude",
        logout_cli: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => "acp-logout", "jsonrpc" => "2.0", "method" => "logout", "params" => %{}}
    },
    result: %{reply: %{}, tag: :reply}
  }
]
