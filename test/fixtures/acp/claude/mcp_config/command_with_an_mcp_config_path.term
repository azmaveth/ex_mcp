[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: %{"mcpServers" => %{"docs" => %{"command" => "d"}}},
      kind: :write_file,
      path: "<sandbox>/mcp.json"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :command,
      opts: [cli_path: "<sandbox>/bin/claude", mcp_config_path: "<sandbox>/mcp.json"]
    },
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--permission-prompt-tool", "stdio", "--mcp-config", "<sandbox>/mcp.json",
         "--permission-mode", "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :note,
      text: "A relative path is resolved against the directory Claude Code runs in"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      content: %{"mcpServers" => %{}},
      kind: :write_file,
      path: "<sandbox>/project/local.json"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :command,
      opts: [
        cli_path: "<sandbox>/bin/claude",
        mcp_config_path: "local.json",
        cwd: "<sandbox>/project"
      ]
    },
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--permission-prompt-tool", "stdio", "--mcp-config", "<sandbox>/project/local.json",
         "--permission-mode", "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  }
]
