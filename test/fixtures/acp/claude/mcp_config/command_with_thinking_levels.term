[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :command, opts: [cli_path: "<sandbox>/bin/claude", thinking: :disabled]},
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--thinking", "disabled", "--permission-prompt-tool", "stdio", "--permission-mode",
         "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :command, opts: [cli_path: "<sandbox>/bin/claude", thinking: :adaptive]},
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--thinking", "adaptive", "--permission-prompt-tool", "stdio", "--permission-mode",
         "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :command, opts: [cli_path: "<sandbox>/bin/claude", thinking: "disabled"]},
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--thinking", "disabled", "--permission-prompt-tool", "stdio", "--permission-mode",
         "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :command, opts: [cli_path: "<sandbox>/bin/claude", thinking: "adaptive"]},
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--thinking", "adaptive", "--permission-prompt-tool", "stdio", "--permission-mode",
         "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :command, opts: [cli_path: "<sandbox>/bin/claude", thinking: 12000]},
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--thinking", "12000", "--permission-prompt-tool", "stdio", "--permission-mode",
         "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  }
]
