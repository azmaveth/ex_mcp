    result: %{reply: [], tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :auth_methods_fresh,
      opts: [cli_path: "<sandbox>/bin/claude", gateway_auth: true]
    },
    result: %{reply: [], tag: :ok}
  }
]
