[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{content: %{"mcpServers" => %{}}, kind: :write_file, path: "<sandbox>/a.json"},
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{content: %{"mcpServers" => %{}}, kind: :write_file, path: "<sandbox>/b.json"},
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :command,
      opts: [
        cli_path: "<sandbox>/bin/claude",
        mcp_config_path: ["<sandbox>/a.json", "<sandbox>/b.json"],
        mcp_servers: %{"docs" => %{"command" => "docs-mcp"}},
        strict_mcp_config: true
      ]
    },
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--permission-prompt-tool", "stdio", "--mcp-config", "<sandbox>/a.json",
         "<sandbox>/b.json", "<generated-mcp-config>", "--permission-mode", "default",
         "--include-partial-messages", "--strict-mcp-config"],
        executable: "<sandbox>/bin/claude",
        generated_mcp_config: %{
          contents: %{"mcpServers" => %{"docs" => %{"command" => "docs-mcp"}}},
          dir_mode: "0700",
          file_mode: "0600"
        }
      },
      tag: :ok
    }
  }
]
