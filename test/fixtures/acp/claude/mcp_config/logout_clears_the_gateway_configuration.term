[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude",
        logout_cli: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-auth",
        "jsonrpc" => "2.0",
        "method" => "authenticate",
        "params" => %{"methodId" => "gateway"}
      }
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => "acp-logout", "jsonrpc" => "2.0", "method" => "logout", "params" => %{}}
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :note, text: "The gateway credentials are gone; the methods are re-offered"},
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-init",
        "jsonrpc" => "2.0",
        "method" => "initialize",
        "params" => %{
          "clientCapabilities" => %{
            "auth" => %{"_meta" => %{"gateway" => true}, "terminal" => true}
          }
        }
      }
    },
    result: %{skipped: true, tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :auth_methods, opts: [cli_path: "<sandbox>/bin/claude", gateway_auth: true]},
    result: %{
      reply: [
        %{
          "args" => ["auth", "login", "--claudeai"],
          "description" => "Use Claude subscription",
          "id" => "claude-ai-login",
          "name" => "Claude Subscription",
          "type" => "terminal"
        },
        %{
          "args" => ["auth", "login", "--console"],
          "description" => "Use Anthropic Console (API usage billing)",
          "id" => "console-login",
          "name" => "Anthropic Console",
          "type" => "terminal"
        },
        %{
          "_meta" => %{"gateway" => %{"protocol" => "anthropic"}},
          "description" => "Use a custom gateway to authenticate and access models",
          "id" => "gateway",
          "name" => "Custom model gateway"
        },
        %{
          "_meta" => %{"gateway" => %{"protocol" => "bedrock"}},
          "description" => "Use a custom gateway to authenticate and access models",
          "id" => "gateway-bedrock",
          "name" => "Custom model gateway"
        }
      ],
      tag: :ok
    }
  }
]
