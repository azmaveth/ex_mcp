[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :command,
      opts: [
        cli_path: "<sandbox>/bin/claude",
        mcp_servers: %{"docs" => %{"command" => "docs-mcp"}},
        strict_mcp_config: true
      ]
    },
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--permission-prompt-tool", "stdio", "--mcp-config",
         "{\"mcpServers\":{\"docs\":{\"command\":\"docs-mcp\"}}}", "--permission-mode", "default",
         "--include-partial-messages", "--strict-mcp-config"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  }
]
