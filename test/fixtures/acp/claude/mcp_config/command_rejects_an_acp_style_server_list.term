[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :command,
      opts: [
        cli_path: "<sandbox>/bin/claude",
        mcp_servers: [
          %{
            "headers" => [%{"name" => "Authorization", "value" => "Bearer x"}],
            "name" => "api",
            "type" => "http",
            "url" => "https://mcp.example.test/"
          }
        ]
      ]
    },
    result: %{
      error: {:invalid_option, :mcp_servers,
       "expected a map of server name to Claude server config, got a list. ACP-style mcpServers lists are not accepted; give each server as `\"name\" => %{\"type\" => \"http\", \"url\" => ..., \"headers\" => %{...}}` or `\"name\" => %{\"command\" => ..., \"args\" => [...], \"env\" => %{...}}`"},
      tag: :error
    }
  }
]
