[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-auth",
        "jsonrpc" => "2.0",
        "method" => "authenticate",
        "params" => %{"methodId" => "carrier-pigeon"}
      }
    },
    result: %{error: "Unsupported Claude auth method: carrier-pigeon", tag: :error}
  }
]
