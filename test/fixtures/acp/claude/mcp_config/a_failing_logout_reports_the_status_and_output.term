[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude-failing"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => "acp-logout", "jsonrpc" => "2.0", "method" => "logout", "params" => %{}}
    },
    result: %{error: "claude auth logout failed with status 3: not authenticated", tag: :error}
  }
]
