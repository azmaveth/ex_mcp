[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-init",
        "jsonrpc" => "2.0",
        "method" => "initialize",
        "params" => %{"clientCapabilities" => %{"auth" => %{"_meta" => %{"gateway" => true}}}}
      }
    },
    result: %{skipped: true, tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :auth_methods, opts: [cli_path: "<sandbox>/bin/claude", gateway_auth: true]},
    result: %{
      reply: [
        %{
          "_meta" => %{"gateway" => %{"protocol" => "anthropic"}},
          "description" => "Use a custom gateway to authenticate and access models",
          "id" => "gateway",
          "name" => "Custom model gateway"
        },
        %{
          "_meta" => %{"gateway" => %{"protocol" => "bedrock"}},
          "description" => "Use a custom gateway to authenticate and access models",
          "id" => "gateway-bedrock",
          "name" => "Custom model gateway"
        }
      ],
      tag: :ok
    }
  }
]
