[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-auth-1",
        "jsonrpc" => "2.0",
        "method" => "authenticate",
        "params" => %{"methodId" => "claude-login"}
      }
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-auth-2",
        "jsonrpc" => "2.0",
        "method" => "authenticate",
        "params" => %{"methodId" => "claude-ai-login"}
      }
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-auth-3",
        "jsonrpc" => "2.0",
        "method" => "authenticate",
        "params" => %{"methodId" => "console-login"}
      }
    },
    result: %{reply: %{}, tag: :reply}
  }
]
