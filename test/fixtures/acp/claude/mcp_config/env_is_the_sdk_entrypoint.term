[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :env, opts: [cli_path: "<sandbox>/bin/claude"]},
    result: %{
      reply: %{"CLAUDE_AGENT_SDK_VERSION" => "0.3.238", "CLAUDE_CODE_ENTRYPOINT" => "sdk-ts"},
      tag: :ok
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :env, opts: [cli_path: "<sandbox>/bin/claude", model: "opus"]},
    result: %{
      reply: %{"CLAUDE_AGENT_SDK_VERSION" => "0.3.238", "CLAUDE_CODE_ENTRYPOINT" => "sdk-ts"},
      tag: :ok
    }
  }
]
