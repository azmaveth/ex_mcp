[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :command,
      opts: [
        cli_path: "<sandbox>/bin/claude",
        mcp_servers: %{
          "api" => %{
            "headers" => %{"Authorization" => "Bearer x"},
            "type" => "http",
            "url" => "https://mcp.example.test/"
          },
          "docs" => %{
            "args" => ["--stdio"],
            "command" => "docs-mcp",
            "env" => %{"TOKEN" => "abc"},
            "type" => "stdio"
          },
          "events" => %{"type" => "sse", "url" => "https://mcp.example.test/sse"}
        }
      ]
    },
    result: %{
      reply: %{
        args: ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
         "--permission-prompt-tool", "stdio", "--mcp-config",
         "{\"mcpServers\":{\"api\":{\"headers\":{\"Authorization\":\"Bearer x\"},\"type\":\"http\",\"url\":\"https://mcp.example.test/\"},\"docs\":{\"args\":[\"--stdio\"],\"command\":\"docs-mcp\",\"env\":{\"TOKEN\":\"abc\"},\"type\":\"stdio\"},\"events\":{\"type\":\"sse\",\"url\":\"https://mcp.example.test/sse\"}}}",
         "--permission-mode", "default", "--include-partial-messages"],
        executable: "<sandbox>/bin/claude"
      },
      tag: :ok
    }
  }
]
