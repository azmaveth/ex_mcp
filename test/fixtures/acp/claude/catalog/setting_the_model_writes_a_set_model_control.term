[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-init",
        "jsonrpc" => "2.0",
        "method" => "initialize",
        "params" => %{"clientCapabilities" => %{}}
      }
    },
    result: %{skipped: true, tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{kind: :post_connect},
    result: %{
      tag: :ok,
      writes: [
        %{
          "request" => %{"subtype" => "initialize"},
          "request_id" => "ex_mcp_initialize_<1>",
          "type" => "control_request"
        }
      ]
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "response" => %{
          "request_id" => "ex_mcp_initialize_<1>",
          "response" => %{"models" => [%{"value" => "sonnet"}, %{"value" => "opus"}]},
          "subtype" => "success"
        },
        "type" => "control_response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-new",
        "jsonrpc" => "2.0",
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      reply: %{
        "configOptions" => [
          %{
            "category" => "mode",
            "currentValue" => "default",
            "description" => "Session permission mode",
            "id" => "mode",
            "name" => "Mode",
            "options" => [
              %{
                "description" => "Always ask before making changes",
                "name" => "Manual",
                "value" => "default"
              },
              %{
                "description" => "Automatically accept all file edits",
                "name" => "Accept edits",
                "value" => "acceptEdits"
              },
              %{
                "description" => "Create a plan before making changes",
                "name" => "Plan",
                "value" => "plan"
              }
            ],
            "type" => "select"
          },
          %{
            "category" => "model",
            "currentValue" => "default",
            "description" => "AI model to use",
            "id" => "model",
            "name" => "Model",
            "options" => [
              %{"name" => "sonnet", "value" => "sonnet"},
              %{"name" => "opus", "value" => "opus"}
            ],
            "type" => "select"
          },
          %{
            "category" => "thought_level",
            "currentValue" => "default",
            "description" => "Available effort levels for this model",
            "id" => "effort",
            "name" => "Effort",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Low", "value" => "low"},
              %{"name" => "Medium", "value" => "medium"},
              %{"name" => "High", "value" => "high"}
            ],
            "type" => "select"
          }
        ],
        "modes" => %{
          "availableModes" => [
            %{
              "description" => "Always ask before making changes",
              "id" => "default",
              "name" => "Manual"
            },
            %{
              "description" => "Automatically accept all file edits",
              "id" => "acceptEdits",
              "name" => "Accept edits"
            },
            %{
              "description" => "Create a plan before making changes",
              "id" => "plan",
              "name" => "Plan"
            }
          ],
          "currentModeId" => "default"
        },
        "sessionId" => "claude_sdk_<1>"
      },
      tag: :reply
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-config",
        "jsonrpc" => "2.0",
        "method" => "session/set_config_option",
        "params" => %{"configId" => "model", "sessionId" => "claude_sdk_<1>", "value" => "opus"}
      }
    },
    result: %{
      reply: %{
        "configOptions" => [
          %{
            "category" => "mode",
            "currentValue" => "default",
            "description" => "Session permission mode",
            "id" => "mode",
            "name" => "Mode",
            "options" => [
              %{
                "description" => "Always ask before making changes",
                "name" => "Manual",
                "value" => "default"
              },
              %{
                "description" => "Automatically accept all file edits",
