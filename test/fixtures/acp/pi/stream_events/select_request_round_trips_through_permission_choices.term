        "data" => %{},
        "id" => "pi-<1>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_state",
