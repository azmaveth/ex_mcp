[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "assistantMessageEvent" => %{"delta" => "early", "type" => "text_delta"},
        "type" => "message_update"
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "default",
            "update" => %{
              "content" => %{"text" => "early", "type" => "text"},
              "sessionUpdate" => "agent_message_chunk"
            }
          }
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "assistantMessageEvent" => %{"delta" => "hmm", "type" => "thinking_delta"},
        "type" => "message_update"
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "default",
            "update" => %{
              "content" => %{"text" => "hmm", "type" => "text"},
              "sessionUpdate" => "agent_thought_chunk"
            }
          }
        }
      ],
      tag: :messages
    }
  }
]
