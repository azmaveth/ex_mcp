[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false,
        delete_session_files: true
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: [
        %{
          "cwd" => "<sandbox>/project",
          "id" => "inside",
          "timestamp" => "2026-01-01T00:00:00Z",
          "type" => "session"
        },
        %{
          "message" => %{"content" => "First prompt", "role" => "user"},
          "timestamp" => "2026-01-01T00:00:01Z",
          "type" => "message"
        }
      ],
      kind: :write_file,
      path: "<sandbox>/sessions/inside.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: [
        %{
          "cwd" => "<sandbox>/project",
          "id" => "nested",
          "timestamp" => "2026-01-01T00:00:00Z",
          "type" => "session"
        },
        %{
          "message" => %{"content" => "First prompt", "role" => "user"},
          "timestamp" => "2026-01-01T00:00:01Z",
          "type" => "message"
        }
      ],
      kind: :write_file,
      path: "<sandbox>/sessions/2026/nested.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: %{
        "sessions" => %{
          "gone" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/gone.jsonl",
            "sessionId" => "gone"
          },
          "inside" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/inside.jsonl",
            "sessionId" => "inside"
          },
          "nested" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/2026/nested.jsonl",
            "sessionId" => "nested"
          }
        },
        "version" => 1
      },
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 1, "method" => "session/delete", "params" => %{"sessionId" => "inside"}}
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 2, "method" => "session/delete", "params" => %{"sessionId" => "nested"}}
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 3, "method" => "session/delete", "params" => %{"sessionId" => "gone"}}
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/sessions/inside.jsonl"},
    result: %{exists: false}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/sessions/2026/nested.jsonl"},
    result: %{exists: false}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/session-map.json"},
    result: %{content: %{"sessions" => %{}, "version" => 1}, exists: true}
  }
]
