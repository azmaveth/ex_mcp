[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: %{
        "sessions" => %{
          "map-only" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/map-only.jsonl",
            "sessionId" => "map-only"
          },
          "renamed-in-map" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/on-disk.jsonl",
            "sessionId" => "renamed-in-map"
          }
        },
        "version" => 1
      },
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: [
        %{
          "cwd" => "<sandbox>/project",
          "id" => "on-disk",
          "timestamp" => "2026-01-01T00:00:00Z",
          "type" => "session"
        },
        %{
          "message" => %{"content" => "First prompt", "role" => "user"},
          "timestamp" => "2026-01-01T00:00:01Z",
          "type" => "message"
        }
      ],
      kind: :write_file,
      path: "<sandbox>/sessions/on-disk.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :list_sessions, params: %{"cwd" => "<sandbox>/project"}},
    result: %{
      reply: %{
        "_meta" => %{},
        "sessions" => [
          %{
            "cwd" => "<sandbox>/project",
            "name" => "First prompt",
            "sessionId" => "on-disk",
            "title" => "First prompt",
            "updatedAt" => "2026-01-01T00:00:01Z"
          }
        ]
      },
      tag: :ok
    }
  }
]
