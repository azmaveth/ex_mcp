[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: [
        %{
          "cwd" => "<sandbox>/project",
          "id" => "mapped",
          "timestamp" => "2026-01-01T00:00:00Z",
          "type" => "session"
        },
        %{
          "message" => %{"content" => "First prompt", "role" => "user"},
          "timestamp" => "2026-01-01T00:00:01Z",
          "type" => "message"
        }
      ],
      kind: :write_file,
      path: "<sandbox>/sessions/mapped.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: %{
        "sessions" => %{
          "mapped" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/mapped.jsonl",
            "sessionId" => "mapped"
          }
        },
        "version" => 1
      },
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 1, "method" => "session/delete", "params" => %{"sessionId" => "mapped"}}
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/sessions/mapped.jsonl"},
    result: %{
      content: "{\"cwd\":\"<sandbox>/project\",\"id\":\"mapped\",\"timestamp\":\"2026-01-01T00:00:00Z\",\"type\":\"session\"}\n{\"message\":{\"content\":\"First prompt\",\"role\":\"user\"},\"timestamp\":\"2026-01-01T00:00:01Z\",\"type\":\"message\"}\n",
      exists: true
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/session-map.json"},
    result: %{content: %{"sessions" => %{}, "version" => 1}, exists: true}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 2, "method" => "session/delete", "params" => %{"sessionId" => "mapped"}}
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/session-map.json"},
    result: %{content: %{"sessions" => %{}, "version" => 1}, exists: true}
  }
]
