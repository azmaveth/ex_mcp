[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: [
        %{
          "cwd" => "<sandbox>/project",
          "id" => "shared",
          "timestamp" => "2026-01-01T00:00:00Z",
          "type" => "session"
        },
        %{
          "message" => %{"content" => "First prompt", "role" => "user"},
          "timestamp" => "2026-01-01T00:00:01Z",
          "type" => "message"
        }
      ],
      kind: :write_file,
      path: "<sandbox>/sessions/scanned.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: %{
        "sessions" => %{
          "shared" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/mapped.jsonl",
            "sessionId" => "shared"
          }
        },
        "version" => 1
      },
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/resume",
        "params" => %{"cwd" => "<sandbox>/project", "sessionId" => "shared"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => "pi-<1>",
          "sessionPath" => "<sandbox>/sessions/mapped.jsonl",
          "type" => "switch_session"
        },
        %{"id" => "pi-<2>", "type" => "get_state"},
        %{"id" => "pi-<3>", "type" => "get_available_models"},
        %{"id" => "pi-<4>", "type" => "get_commands"}
      ]
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: %{
        "sessions" => %{"shared" => %{"sessionFile" => 7, "sessionId" => "shared"}},
        "version" => 1
      },
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 2,
        "method" => "session/resume",
        "params" => %{"cwd" => "<sandbox>/project", "sessionId" => "shared"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => "pi-<5>",
          "sessionPath" => "<sandbox>/sessions/scanned.jsonl",
          "type" => "switch_session"
        },
        %{"id" => "pi-<6>", "type" => "get_state"},
        %{"id" => "pi-<7>", "type" => "get_available_models"},
        %{"id" => "pi-<8>", "type" => "get_commands"}
      ]
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: %{"sessions" => %{}, "version" => 1},
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 3,
        "method" => "session/resume",
        "params" => %{"cwd" => "<sandbox>/project", "sessionId" => "shared"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => "pi-<9>",
          "sessionPath" => "<sandbox>/sessions/scanned.jsonl",
          "type" => "switch_session"
        },
        %{"id" => "pi-<10>", "type" => "get_state"},
        %{"id" => "pi-<11>", "type" => "get_available_models"},
        %{"id" => "pi-<12>", "type" => "get_commands"}
      ]
    }
  }
]
