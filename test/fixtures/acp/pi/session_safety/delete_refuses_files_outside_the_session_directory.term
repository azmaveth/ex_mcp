[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false,
        delete_session_files: true
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{content: "keep\n", kind: :write_file, path: "<sandbox>/project/elsewhere.jsonl"},
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{content: "keep\n", kind: :write_file, path: "<sandbox>/project/escape.jsonl"},
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{content: "keep\n", kind: :write_file, path: "<sandbox>/sessions-other/sibling.jsonl"},
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: "keep\n",
      kind: :write_file,
      path: "<sandbox>/sessions/../project/traversal.jsonl"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: %{
        "sessions" => %{
          "elsewhere" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/project/elsewhere.jsonl",
            "sessionId" => "elsewhere"
          },
          "escape" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/../project/escape.jsonl",
            "sessionId" => "escape"
          },
          "relative" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "sessions/relative.jsonl",
            "sessionId" => "relative"
          },
          "sibling" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions-other/sibling.jsonl",
            "sessionId" => "sibling"
          },
          "traversal" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/../project/traversal.jsonl",
            "sessionId" => "traversal"
          }
        },
        "version" => 1
      },
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/delete",
        "params" => %{"sessionId" => "elsewhere"}
      }
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 2, "method" => "session/delete", "params" => %{"sessionId" => "escape"}}
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 3, "method" => "session/delete", "params" => %{"sessionId" => "sibling"}}
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 4,
        "method" => "session/delete",
        "params" => %{"sessionId" => "traversal"}
      }
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 5,
        "method" => "session/delete",
        "params" => %{"sessionId" => "relative"}
      }
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/project/elsewhere.jsonl"},
    result: %{content: "keep\n", exists: true}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/project/escape.jsonl"},
    result: %{content: "keep\n", exists: true}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/sessions-other/sibling.jsonl"},
    result: %{content: "keep\n", exists: true}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/project/traversal.jsonl"},
    result: %{content: "keep\n", exists: true}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/session-map.json"},
    result: %{content: %{"sessions" => %{}, "version" => 1}, exists: true}
  }
]
