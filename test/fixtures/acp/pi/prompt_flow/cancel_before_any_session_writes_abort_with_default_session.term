[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :outbound, message: %{"method" => "session/cancel", "params" => %{}}},
    result: %{messages: [], tag: :messages_and_write, writes: [%{"type" => "abort"}]}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/prompt",
        "params" => %{"prompt" => "x", "sessionId" => nil}
      }
    },
    result: %{tag: :ok, writes: [%{"id" => "msg-1", "message" => "x", "type" => "prompt"}]}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 2,
        "method" => "session/prompt",
        "params" => %{"prompt" => "y", "sessionId" => nil}
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "default",
            "update" => %{
              "content" => %{"text" => "Queued message (position 1).", "type" => "text"},
              "sessionUpdate" => "agent_message_chunk"
            }
          }
        },
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "default",
            "update" => %{
              "_meta" => %{"ex_mcp" => %{"pi" => %{"queueDepth" => 1, "running" => true}}},
              "sessionUpdate" => "session_info_update"
            }
          }
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :outbound, message: %{"method" => "session/cancel", "params" => %{}}},
    result: %{
      messages: [
        %{"id" => 2, "jsonrpc" => "2.0", "result" => %{"stopReason" => "cancelled"}},
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "default",
            "update" => %{
              "content" => %{"text" => "Cleared queued prompts.", "type" => "text"},
              "sessionUpdate" => "agent_message_chunk"
            }
          }
        },
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "default",
            "update" => %{
              "_meta" => %{"ex_mcp" => %{"pi" => %{"queueDepth" => 0, "running" => true}}},
              "sessionUpdate" => "session_info_update"
            }
          }
        }
      ],
      tag: :messages_and_write,
      writes: [%{"type" => "abort"}]
    }
  }
]
