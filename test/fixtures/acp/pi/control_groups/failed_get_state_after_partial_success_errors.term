[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{"id" => "pi-<1>", "type" => "new_session"},
        %{"id" => "pi-<2>", "type" => "get_state"},
        %{"id" => "pi-<3>", "type" => "get_available_models"},
        %{"id" => "pi-<4>", "type" => "get_commands"}
      ]
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "new_session",
        "data" => %{},
        "id" => "pi-<1>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_available_models",
        "data" => %{
          "models" => [
            %{"id" => "claude-sonnet-4", "name" => "Claude Sonnet 4", "provider" => "anthropic"},
            %{"id" => "gpt-5.1", "name" => "GPT-5.1", "provider" => "openai"}
          ]
        },
        "id" => "pi-<3>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_state",
        "error" => "state unavailable",
        "id" => "pi-<2>",
        "success" => false,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "error" => %{"code" => -32603, "message" => "state unavailable"},
          "id" => 1,
          "jsonrpc" => "2.0"
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_commands",
        "data" => %{"commands" => []},
        "id" => "pi-<4>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  }
]
