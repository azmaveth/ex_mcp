[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: %{
        "sessions" => %{
          "mapped" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/mapped.jsonl",
            "sessionId" => "mapped"
          }
        },
        "version" => 1
      },
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/load",
        "params" => %{"cwd" => "<sandbox>/project", "sessionId" => "mapped"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => "pi-<1>",
          "sessionPath" => "<sandbox>/sessions/mapped.jsonl",
          "type" => "switch_session"
        },
        %{"id" => "pi-<2>", "type" => "get_messages"},
        %{"id" => "pi-<3>", "type" => "get_state"},
        %{"id" => "pi-<4>", "type" => "get_available_models"},
        %{"id" => "pi-<5>", "type" => "get_commands"}
      ]
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "switch_session",
        "error" => "no such session",
        "id" => "pi-<1>",
        "success" => false,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "error" => %{"code" => -32603, "message" => "no such session"},
          "id" => 1,
          "jsonrpc" => "2.0"
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_messages",
        "data" => %{"messages" => []},
        "id" => "pi-<2>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :note, text: "Responses for the failed group are untracked and skipped"},
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_state",
        "data" => %{
          "cwd" => "<sandbox>/project",
          "model" => %{"id" => "claude-sonnet-4", "provider" => "anthropic"},
          "sessionFile" => "<sandbox>/sessions/pi-session.jsonl",
          "sessionId" => "pi-session",
          "thinkingLevel" => "medium"
        },
        "id" => "pi-<3>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_available_models",
        "data" => %{
          "models" => [
            %{"id" => "claude-sonnet-4", "name" => "Claude Sonnet 4", "provider" => "anthropic"},
            %{"id" => "gpt-5.1", "name" => "GPT-5.1", "provider" => "openai"}
          ]
        },
        "id" => "pi-<4>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_commands",
        "data" => %{"commands" => []},
        "id" => "pi-<5>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  }
]
