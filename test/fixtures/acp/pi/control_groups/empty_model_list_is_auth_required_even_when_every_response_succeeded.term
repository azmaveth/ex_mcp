[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{"id" => "pi-<1>", "type" => "new_session"},
        %{"id" => "pi-<2>", "type" => "get_state"},
        %{"id" => "pi-<3>", "type" => "get_available_models"},
        %{"id" => "pi-<4>", "type" => "get_commands"}
      ]
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "new_session",
        "data" => %{},
        "id" => "pi-<1>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_state",
        "data" => %{
          "cwd" => "<sandbox>/project",
          "model" => %{"id" => "claude-sonnet-4", "provider" => "anthropic"},
          "sessionFile" => "<sandbox>/sessions/pi-session.jsonl",
          "sessionId" => "pi-session",
          "thinkingLevel" => "medium"
        },
        "id" => "pi-<2>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_commands",
        "data" => %{"commands" => []},
        "id" => "pi-<4>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_available_models",
        "data" => %{"models" => []},
        "id" => "pi-<3>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "error" => %{
            "code" => -32000,
            "data" => %{
              "authMethods" => [
                %{
                  "_meta" => %{
                    "terminal-auth" => %{
                      "args" => [],
                      "command" => "<sandbox>/bin/pi",
                      "label" => "Launch pi"
                    }
                  },
                  "args" => [],
                  "description" => "Start pi interactively to configure API keys or login",
                  "env" => %{},
                  "id" => "pi_terminal_login",
                  "name" => "Launch pi in the terminal",
                  "type" => "terminal"
                }
              ]
            },
            "message" => "Configure an API key or log in with an OAuth provider."
          },
          "id" => 1,
          "jsonrpc" => "2.0"
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :note, text: "The failed session left no map entry"},
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/session-map.json"},
    result: %{exists: false}
  }
]
