[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/prompt",
        "params" => %{"prompt" => "/model", "sessionId" => "requested"}
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "requested",
            "update" => %{
              "content" => %{
                "text" => "Use the ACP model selector to change models.",
                "type" => "text"
              },
              "sessionUpdate" => "agent_message_chunk"
            }
          }
        }
      ],
      reply: %{"stopReason" => "end_turn"},
      tag: :messages_and_reply
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 2,
        "method" => "session/prompt",
        "params" => %{"prompt" => "/thinking", "sessionId" => nil}
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "default",
            "update" => %{
              "content" => %{
                "text" => "Use the ACP mode selector to change thinking level.",
                "type" => "text"
              },
              "sessionUpdate" => "agent_message_chunk"
            }
          }
        }
      ],
      reply: %{"stopReason" => "end_turn"},
      tag: :messages_and_reply
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 3,
        "method" => "session/prompt",
        "params" => %{"prompt" => "/name", "sessionId" => nil}
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "default",
            "update" => %{
              "content" => %{"text" => "Usage: /name <name>", "type" => "text"},
              "sessionUpdate" => "agent_message_chunk"
            }
          }
        }
      ],
      reply: %{"stopReason" => "end_turn"},
      tag: :messages_and_reply
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 4,
        "method" => "session/prompt",
        "params" => %{"prompt" => "/export", "sessionId" => nil}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "id" => "pi-<1>",
          "outputPath" => "<sandbox>/project/pi-session-default.html",
          "type" => "export_html"
        }
      ]
    }
  }
]
