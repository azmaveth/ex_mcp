[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{"id" => "pi-<1>", "type" => "new_session"},
        %{"id" => "pi-<2>", "type" => "get_state"},
        %{"id" => "pi-<3>", "type" => "get_available_models"},
        %{"id" => "pi-<4>", "type" => "get_commands"}
      ]
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "new_session",
        "data" => %{},
        "id" => "pi-<1>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_state",
        "data" => %{
          "cwd" => "<sandbox>/project",
          "model" => %{"id" => "claude-sonnet-4", "provider" => "anthropic"},
          "sessionFile" => "<sandbox>/sessions/pi-session.jsonl",
          "sessionId" => "pi-session",
          "thinkingLevel" => "medium"
        },
        "id" => "pi-<2>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_available_models",
        "data" => %{
          "models" => [
            %{"id" => "claude-sonnet-4", "name" => "Claude Sonnet 4", "provider" => "anthropic"},
            %{"id" => "gpt-5.1", "name" => "GPT-5.1", "provider" => "openai"}
          ]
        },
        "id" => "pi-<3>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_commands",
        "data" => %{"commands" => []},
        "id" => "pi-<4>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "id" => 1,
          "jsonrpc" => "2.0",
          "result" => %{
            "_meta" => %{
              "ex_mcp" => %{"pi" => %{"sessionFile" => "<sandbox>/sessions/pi-session.jsonl"}}
            },
            "configOptions" => [
              %{
                "category" => "model",
                "currentValue" => "anthropic/claude-sonnet-4",
                "description" => "Select the model for this session",
                "id" => "model",
                "name" => "Model",
                "options" => [
                  %{
                    "description" => nil,
                    "name" => "anthropic/Claude Sonnet 4",
                    "value" => "anthropic/claude-sonnet-4"
                  },
                  %{"description" => nil, "name" => "openai/GPT-5.1", "value" => "openai/gpt-5.1"}
                ],
                "type" => "select"
              },
              %{
                "category" => "thought_level",
                "currentValue" => "medium",
                "description" => "Set the reasoning effort for this session",
                "id" => "thought_level",
                "name" => "Thinking",
                "options" => [
                  %{"description" => nil, "name" => "Thinking: off", "value" => "off"},
                  %{"description" => nil, "name" => "Thinking: minimal", "value" => "minimal"},
                  %{"description" => nil, "name" => "Thinking: low", "value" => "low"},
                  %{"description" => nil, "name" => "Thinking: medium", "value" => "medium"},
                  %{"description" => nil, "name" => "Thinking: high", "value" => "high"},
                  %{"description" => nil, "name" => "Thinking: xhigh", "value" => "xhigh"}
                ],
                "type" => "select"
              },
              %{
                "category" => "other",
                "currentValue" => "true",
                "description" => "Automatically compact context when nearly full",
                "id" => "auto_compaction",
                "name" => "Auto Compaction",
                "options" => [
                  %{"name" => "On", "value" => "true"},
                  %{"name" => "Off", "value" => "false"}
                ],
                "type" => "select"
              },
              %{
                "category" => "other",
                "currentValue" => "true",
                "description" => "Automatically retry on transient errors",
                "id" => "auto_retry",
                "name" => "Auto Retry",
                "options" => [
                  %{"name" => "On", "value" => "true"},
                  %{"name" => "Off", "value" => "false"}
                ],
                "type" => "select"
              },
              %{
                "category" => "other",
                "currentValue" => "all",
                "description" => "How steering messages are delivered",
                "id" => "steering_mode",
                "name" => "Steering Mode",
                "options" => [
                  %{"name" => "All", "value" => "all"},
                  %{"name" => "One at a time", "value" => "one-at-a-time"}
                ],
                "type" => "select"
              },
              %{
                "category" => "other",
                "currentValue" => "all",
                "description" => "How follow-up messages are delivered",
                "id" => "follow_up_mode",
                "name" => "Follow-up Mode",
                "options" => [
                  %{"name" => "All", "value" => "all"},
                  %{"name" => "One at a time", "value" => "one-at-a-time"}
                ],
                "type" => "select"
              }
            ],
            "models" => %{
              "availableModels" => [
                %{
                  "description" => nil,
                  "modelId" => "anthropic/claude-sonnet-4",
                  "name" => "anthropic/Claude Sonnet 4"
                },
                %{"description" => nil, "modelId" => "openai/gpt-5.1", "name" => "openai/GPT-5.1"}
              ],
              "currentModelId" => "anthropic/claude-sonnet-4"
            },
            "modes" => %{
              "availableModes" => [
                %{"description" => nil, "id" => "off", "name" => "Thinking: off"},
                %{"description" => nil, "id" => "minimal", "name" => "Thinking: minimal"},
                %{"description" => nil, "id" => "low", "name" => "Thinking: low"},
                %{"description" => nil, "id" => "medium", "name" => "Thinking: medium"},
                %{"description" => nil, "id" => "high", "name" => "Thinking: high"},
                %{"description" => nil, "id" => "xhigh", "name" => "Thinking: xhigh"}
              ],
              "currentModeId" => "medium"
            },
            "sessionId" => "pi-session"
          }
        },
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "pi-session",
            "update" => %{
              "availableCommands" => [
                %{
                  "description" => "Manually compact the session context",
                  "input" => %{"hint" => "optional instructions"},
                  "name" => "compact"
                },
                %{
                  "description" => "Toggle automatic context compaction",
                  "input" => %{"hint" => "on | off"},
                  "name" => "autocompact"
                },
                %{"description" => "Export session to HTML", "name" => "export"},
                %{"description" => "Show session stats", "name" => "session"},
                %{
                  "description" => "Set session display name",
                  "input" => %{"hint" => "name"},
                  "name" => "name"
                },
                %{
                  "description" => "Get or set Pi steering mode",
                  "input" => %{"hint" => "all | one-at-a-time"},
                  "name" => "steering"
                },
                %{
                  "description" => "Get or set Pi follow-up mode",
                  "input" => %{"hint" => "all | one-at-a-time"},
                  "name" => "follow-up"
                },
                %{"description" => "Show Pi changelog", "name" => "changelog"}
              ],
              "sessionUpdate" => "available_commands_update"
            }
          }
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 2,
        "method" => "session/prompt",
        "params" => %{"prompt" => "/session", "sessionId" => "pi-session"}
      }
    },
    result: %{tag: :ok, writes: [%{"id" => "pi-<5>", "type" => "get_session_stats"}]}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_session_stats",
        "data" => %{
          "cost" => 0.5,
          "sessionFile" => "<sandbox>/sessions/pi-session.jsonl",
          "sessionId" => "pi-session",
          "totalMessages" => 12
        },
        "id" => "pi-<5>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "pi-session",
            "update" => %{
              "content" => %{
                "text" => "Session: pi-session\nSession file: <sandbox>/sessions/pi-session.jsonl\nMessages: 12\nCost: 0.5",
                "type" => "text"
              },
              "sessionUpdate" => "agent_message_chunk"
            }
          }
        },
        %{"id" => 2, "jsonrpc" => "2.0", "result" => %{"stopReason" => "end_turn"}}
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 3,
        "method" => "session/prompt",
        "params" => %{"prompt" => "/session", "sessionId" => "pi-session"}
      }
    },
    result: %{tag: :ok, writes: [%{"id" => "pi-<6>", "type" => "get_session_stats"}]}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_session_stats",
        "data" => %{"tokens" => 42},
        "id" => "pi-<6>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "pi-session",
            "update" => %{
              "content" => %{"text" => "Session stats:\n{\n  \"tokens\": 42\n}", "type" => "text"},
              "sessionUpdate" => "agent_message_chunk"
            }
          }
        },
        %{"id" => 3, "jsonrpc" => "2.0", "result" => %{"stopReason" => "end_turn"}}
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 4,
        "method" => "session/prompt",
        "params" => %{"prompt" => "/session", "sessionId" => "pi-session"}
      }
    },
    result: %{tag: :ok, writes: [%{"id" => "pi-<7>", "type" => "get_session_stats"}]}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "command" => "get_session_stats",
        "data" => "not a map",
        "id" => "pi-<7>",
        "success" => true,
        "type" => "response"
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "pi-session",
            "update" => %{
              "content" => %{"text" => "Command completed.", "type" => "text"},
              "sessionUpdate" => "agent_message_chunk"
            }
          }
        },
        %{"id" => 4, "jsonrpc" => "2.0", "result" => %{"stopReason" => "end_turn"}}
      ],
      tag: :messages
    }
  }
]
