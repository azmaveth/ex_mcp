[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      content: %{
        "sessions" => %{
          "mapped" => %{
            "cwd" => "<sandbox>/project",
            "sessionFile" => "<sandbox>/sessions/mapped.jsonl",
            "sessionId" => "mapped"
          }
        },
        "version" => 1
      },
      kind: :write_file,
      path: "<sandbox>/session-map.json"
    },
    result: %{}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/load",
        "params" => %{"cwd" => "rel", "sessionId" => "mapped"}
      }
    },
    result: %{error: "cwd must be an absolute path: rel", tag: :error}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 2,
        "method" => "session/resume",
        "params" => %{"cwd" => "rel", "sessionId" => "mapped"}
      }
    },
    result: %{error: "cwd must be an absolute path: rel", tag: :error}
  }
]
