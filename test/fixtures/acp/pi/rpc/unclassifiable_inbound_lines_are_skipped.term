[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :inbound_raw, line: ""},
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :inbound_raw, line: "   \n"},
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :inbound_raw, line: "not json"},
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :inbound_raw, line: "{\"foo\":1}"},
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :inbound_raw, line: "[1,2]"},
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :inbound_raw, line: "{\"type\":\"response\",\"id\":7,\"success\":true}"},
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound_raw,
      line: "{\"type\":\"response\",\"id\":\"pi-<1>\",\"success\":true,\"data\":{}}"
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :inbound_raw,
      line: "{\"type\":\"response\",\"id\":\"pi-<1>\",\"success\":false,\"error\":\"late\"}"
    },
    result: %{skipped: true, tag: :skip}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :inbound_raw, line: "{\"type\":42}"},
    result: %{skipped: true, tag: :skip}
  }
