[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/load",
        "params" => %{"cwd" => "<sandbox>/project", "sessionId" => "ghost"}
      }
    },
    result: %{error: "Unknown sessionId: ghost", tag: :error}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 2, "method" => "session/load", "params" => %{"cwd" => "<sandbox>"}}
    },
    result: %{error: "Unknown sessionId: ", tag: :error}
  }
]
