[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/session-map.json"},
    result: %{exists: false}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 1, "method" => "session/delete", "params" => %{"sessionId" => "ghost"}}
    },
    result: %{reply: %{}, tag: :reply}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :read_file, path: "<sandbox>/session-map.json"},
    result: %{content: %{"sessions" => %{}, "version" => 1}, exists: true}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{kind: :outbound, message: %{"id" => 2, "method" => "session/delete", "params" => %{}}},
    result: %{reply: %{}, tag: :reply}
  }
]
