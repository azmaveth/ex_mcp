[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 1, "method" => "session/new", "params" => %{"cwd" => "relative/dir"}}
    },
    result: %{error: "cwd must be an absolute path: relative/dir", tag: :error}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => 2, "method" => "session/new", "params" => %{"cwd" => 42}}
    },
    result: %{error: "cwd is required", tag: :error}
  }
]
