[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: false
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/set_model",
        "params" => %{"modelId" => "gpt-5.1", "sessionId" => "pi-session"}
      }
    },
    result: %{error: "Unknown modelId: gpt-5.1", tag: :error}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 2,
        "method" => "session/set_model",
        "params" => %{"modelId" => "openai/gpt-5.1", "sessionId" => "pi-session"}
      }
    },
    result: %{
      messages: [
        %{
          "jsonrpc" => "2.0",
          "method" => "session/update",
          "params" => %{
            "sessionId" => "pi-session",
            "update" => %{
              "configOptions" => [
                %{
                  "category" => "thought_level",
                  "currentValue" => "medium",
                  "description" => "Set the reasoning effort for this session",
                  "id" => "thought_level",
                  "name" => "Thinking",
                  "options" => [
                    %{"description" => nil, "name" => "Thinking: off", "value" => "off"},
                    %{"description" => nil, "name" => "Thinking: minimal", "value" => "minimal"},
                    %{"description" => nil, "name" => "Thinking: low", "value" => "low"},
                    %{"description" => nil, "name" => "Thinking: medium", "value" => "medium"},
                    %{"description" => nil, "name" => "Thinking: high", "value" => "high"},
                    %{"description" => nil, "name" => "Thinking: xhigh", "value" => "xhigh"}
                  ],
                  "type" => "select"
                },
                %{
                  "category" => "other",
                  "currentValue" => "true",
                  "description" => "Automatically compact context when nearly full",
                  "id" => "auto_compaction",
                  "name" => "Auto Compaction",
                  "options" => [
                    %{"name" => "On", "value" => "true"},
                    %{"name" => "Off", "value" => "false"}
                  ],
                  "type" => "select"
                },
                %{
                  "category" => "other",
                  "currentValue" => "true",
                  "description" => "Automatically retry on transient errors",
                  "id" => "auto_retry",
                  "name" => "Auto Retry",
                  "options" => [
                    %{"name" => "On", "value" => "true"},
                    %{"name" => "Off", "value" => "false"}
                  ],
                  "type" => "select"
                },
                %{
                  "category" => "other",
                  "currentValue" => "all",
                  "description" => "How steering messages are delivered",
                  "id" => "steering_mode",
                  "name" => "Steering Mode",
                  "options" => [
                    %{"name" => "All", "value" => "all"},
                    %{"name" => "One at a time", "value" => "one-at-a-time"}
                  ],
                  "type" => "select"
                },
                %{
                  "category" => "other",
                  "currentValue" => "all",
                  "description" => "How follow-up messages are delivered",
                  "id" => "follow_up_mode",
                  "name" => "Follow-up Mode",
                  "options" => [
                    %{"name" => "All", "value" => "all"},
                    %{"name" => "One at a time", "value" => "one-at-a-time"}
                  ],
                  "type" => "select"
                }
              ],
              "sessionUpdate" => "config_option_update"
            }
          }
        }
      ],
      tag: :messages_and_write,
      writes: [%{"modelId" => "gpt-5.1", "provider" => "openai", "type" => "set_model"}]
    }
  },
