[
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        agent_dir: "<sandbox>/agent",
        session_dir: "<sandbox>/sessions",
        session_map_path: "<sandbox>/session-map.json",
        cli_path: "<sandbox>/bin/pi",
        update_notice: false,
        managed: true
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 1,
        "method" => "session/set_mode",
        "params" => %{"modeId" => "high", "sessionId" => "pi-session"}
      }
    },
    result: %{error: ":no_active_pi_session", tag: :error}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 2,
        "method" => "session/set_model",
        "params" => %{"modelId" => "openai/gpt-5.1", "sessionId" => "pi-session"}
      }
    },
    result: %{error: ":no_active_pi_session", tag: :error}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 3,
        "method" => "session/set_config_option",
        "params" => %{"configId" => "auto_retry", "sessionId" => "pi-session", "value" => true}
      }
    },
    result: %{error: ":no_active_pi_session", tag: :error}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 4,
        "method" => "session/set_config_option",
        "params" => %{
          "configId" => "thought_level",
          "sessionId" => "pi-session",
          "value" => "low"
        }
      }
    },
    result: %{error: ":no_active_pi_session", tag: :error}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 5,
        "method" => "session/set_config_option",
        "params" => %{
          "configId" => "steering_mode",
          "sessionId" => "pi-session",
          "value" => "all"
        }
      }
    },
    result: %{error: ":no_active_pi_session", tag: :error}
  },
  %ExMCP.Test.PiGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => 6,
        "method" => "session/set_config_option",
        "params" => %{"configId" => "model", "sessionId" => "pi-session", "value" => "nope"}
      }
    },
    result: %{error: "Unknown modelId: nope", tag: :error}
  }
]
